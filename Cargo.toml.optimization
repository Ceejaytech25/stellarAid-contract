# Cargo.toml Release Profile Optimization
# Add the following to your Cargo.toml to optimize contract size

[profile.release]
# Optimize for size (z = minimize binary size)
opt-level = "z"

# Enable Link Time Optimization for smaller binaries
lto = true

# Use a single codegen unit for better optimization
codegen-units = 1

# Strip panic strings to reduce binary size
panic = "abort"

# Strip debug symbols
strip = true